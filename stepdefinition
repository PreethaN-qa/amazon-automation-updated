@And("User adds multiple new address")
public void user_adds_multiple_new_address(DataTable dataTable) throws InterruptedException {

	 List<Map<String, String>> rows = dataTable.asMaps(String.class, String.class);

	    for (Map<String, String> row : rows) {

	        String name     = row.get("Name");
	        String mobile   = row.get("Mobile");
	        String pincode  = row.get("Pincode");
	        String address1 = row.get("Address1");
	        String address2 = row.get("Address2");
	        String landmark = row.get("Landmark");
	        String city     = row.get("City");
	        String state    = row.get("State");
	        String action   = row.get("Action");

	        //  wait and click add new address
	        Thread.sleep(2000);
	        click(ap.getAddNewAddress());
	        Thread.sleep(2000);
	       
	        ap.getFullName().clear();
	        ap.getMobileNumber().clear();
	        ap.getPinCode().clear();
	        ap.getAddressLine1().clear();
	        ap.getaddressLine2().clear();
	        ap.getlandmark().clear();
	        ap.getCity().clear();

	        // type values
	        sendkeys(ap.getFullName(), name);
	        sendkeys(ap.getMobileNumber(), mobile);
	        sendkeys(ap.getPinCode(), pincode);
	        sendkeys(ap.getAddressLine1(), address1);
	        sendkeys(ap.getaddressLine2(), address2);
	        sendkeys(ap.getlandmark(), landmark);
	        sendkeys(ap.getCity(), city);

	        click(ap.getStateDropdown());
	        Thread.sleep(3000);

	        WebElement option = ap.getStateOption(state);
	        jsScrollAndClick(option);

	        Thread.sleep(2000);
	        System.out.println("Selected State for " + name + " : " + state);

        if (action.equalsIgnoreCase("CANCEL")) {
            click(ap.getCancelButton());
            System.out.println("Cancelled address for: " + name);
        } else if (action.equalsIgnoreCase("SAVE")) {
            click(ap.getSaveAddress());
            System.out.println("Saved address for: " + name);
        }
    }
    }
   
    
    
