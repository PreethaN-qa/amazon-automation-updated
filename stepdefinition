    @Then("No results message should be displayed")
    public void no_results_message_should_be_displayed() throws InterruptedException {
    	 click(ap.getProductSearch());
    	  Thread.sleep(5000);
    	//  Check if NO RESULTS message exists
    	    List<WebElement> noResultsMsg = ap.getNoResultsMessage();

    	    if (noResultsMsg.size() > 0 && noResultsMsg.get(0).isDisplayed()) {
    	        System.out.println(" No results message displayed successfully");
    	        return;  // PASS
    	    }

    	    //  If no message shown, check if Amazon showing products
    	    List<WebElement> results = ap.getSearchResults();

    	    if (results.size() > 0) {
    	        System.out.println("Amazon is showing products for invalid product search");
    	        System.out.println(" Total products shown: " + results.size());

    	        //  FAILED status
    	        Assert.fail("FAIL: Invalid product search should show 'No results', but products are displayed!");
    	    }

    	    //  If neither msg nor results -- also FAIL (unexpected behavior)
    	    Assert.fail("FAIL: No results msg not shown and no products list found - page behavior unknown!");
    	}
