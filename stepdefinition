 @Then("user closes chat help window")
 public void user_closes_chat_help_window() throws InterruptedException {

	  //  safety check
	    if (parentWindow == null) {
	        throw new RuntimeException(" parentWindow is NULL. Store it before opening chat!");
	    }

	    //wait until new window opens
	    int count = driver.getWindowHandles().size();
	    int tries = 0;
	    while (count < 2 && tries < 10) {
	        Thread.sleep(1000);
	        count = driver.getWindowHandles().size();
	        tries++;
	    }

	    System.out.println("Window Count = " + count);

	    // switch to child window and close it
	    for (String win : driver.getWindowHandles()) {
	        if (!win.equals(parentWindow)) {
	            driver.switchTo().window(win);
	            Thread.sleep(2000);

	            System.out.println("Closing Chat Window = " + win);
	            driver.close();
	            break;
	        }
	    }

	    //  back to parent
	    driver.switchTo().window(parentWindow);
	    Thread.sleep(3000);

	    System.out.println("Back to HelpCenter Parent Window");
	}
 
